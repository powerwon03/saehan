# Copy to .env.local (never commit it) and fill in. On Vercel, set the same names in Project → Settings → Environment Variables.
# Next.js (dev/build/start) and the npm scripts (db:migrate, company:create, seed:demo) read .env.local.

# Supabase Postgres, "Transaction pooler" connection string (port 6543):
#   Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Leave empty locally to use the embedded PGlite database instead (development and tests only).
DATABASE_URL=

# Signs the login cookies. At least 32 characters, random, different per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Bearer secret for GET /api/cron/expire (Vercel Cron or Supabase pg_cron). Generate like SESSION_SECRET.
# Empty = the cron route answers 503 CRON_DISABLED (expiry still happens on every request).
CRON_SECRET=

# Company code used by /login and /w/login when the address has no ?company=
DEFAULT_COMPANY=

# Optional, local only: folder for the embedded PGlite database when DATABASE_URL is empty (default ./.data/pglite).
PGLITE_DIR=
